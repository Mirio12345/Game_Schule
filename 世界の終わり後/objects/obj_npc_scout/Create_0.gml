/// @description obj_npc_scout – Create
/// Investigation NPC 2: knows where the thief hide out is -> military outpost raid.

event_inherited();

npc_name = "Rin";
dialogue_lines = [
    "Chasing the manifest thief? Word is they holed up in a military outpost past the wastes.",
    "The outer gate is sealed, but the patrol shifts change at the north wall. One loud rush and it's yours.",
    "Grab your gear from the trader in the Bazaar first. You'll need it."
];