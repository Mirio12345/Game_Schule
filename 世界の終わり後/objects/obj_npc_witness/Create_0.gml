/// @description obj_npc_witness – Create
/// Investigation NPC 1: witnessed the Bazaar theft, points to military boots.

event_inherited();

npc_name = "Kael";
dialogue_lines = [
    "Psst... you're the one who woke up in the med-bay, right?",
    "Last night someone smashed a Bazaar stall and made off with the shipment manifest.",
    "I saw boots with military treads heading north past the old checkpoint. That's no street crew."
